[Unit]
Description=Apply OPiBot performance mode
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/sbin/opibot-performance-mode

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/opibot-performance-mode apply-config
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
