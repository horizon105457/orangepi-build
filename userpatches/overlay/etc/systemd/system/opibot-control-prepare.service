[Unit]
Description=Switch OPiBot to control-active before control workloads
Before=opibot-control.target
PartOf=opibot-control.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/opibot-runtime-mode apply control-active
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=opibot-control.target
